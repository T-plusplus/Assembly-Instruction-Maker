<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.0.0</Version>
    <Copyright>Copyright ©  2018</Copyright>
    <!-- Preserve the original font while migrating the existing form layouts. -->
    <ApplicationDefaultFont>Microsoft Sans Serif, 8.25pt</ApplicationDefaultFont>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="MipsFieldsForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="MipsFieldsForm.Designer.cs">
      <DependentUpon>MipsFieldsForm.cs</DependentUpon>
    </Compile>
    <Compile Update="MipsPnmForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="MipsPnmForm.Designer.cs">
      <DependentUpon>MipsPnmForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="MipsFieldsForm.resx">
      <DependentUpon>MipsFieldsForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="MipsPnmForm.resx">
      <DependentUpon>MipsPnmForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
